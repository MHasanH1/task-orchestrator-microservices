# Stage 1: Build & Transpile TypeScript
FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Bundle Board Server
RUN npx --yes esbuild workers/board.ts --bundle --platform=node --target=node22 --outfile=dist/board.js --packages=external

# Stage 2: Minimal Production Runner
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV BOARD_PORT=3001

# Install only production dependencies (ignoring lifecycle scripts)
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# Copy bundled board server
COPY --from=builder /app/dist ./dist

EXPOSE 3001

CMD ["node", "dist/board.js"]